# Origin API saja, tanpa path /api/v1.
VITE_API_URL=http://localhost:8000
# Sebelum deploy produksi: ubah menjadi false dan isi origin API di atas.
VITE_USE_MOCK=true
# false = AI asli backend; true = balasan tiruan.
VITE_USE_AI_MOCK=false
VITE_IDLE_TIMEOUT_SECONDS=180
VITE_STAFF_IDLE_TIMEOUT_SECONDS=900
